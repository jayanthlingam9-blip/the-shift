# Postgres. Points at the docker-compose service by default (host port 15432);
# keep the password in sync with POSTGRES_PASSWORD in docker-compose.yml.
DATABASE_URL=postgresql://raguser:ragpass@localhost:15432/ragdb

# LlamaParse PDF parsing. NUMBERED, not bare: scripts/parse_documents.py reads
# LLAMA_CLOUD_API_KEY_1/_2/_3 and rotates across whichever are set.
# _1 is required; _2 and _3 are optional and only widen the rate-limit budget.
LLAMA_CLOUD_API_KEY_1=
LLAMA_CLOUD_API_KEY_2=
LLAMA_CLOUD_API_KEY_3=

# Firecrawl HTML crawling.
FIRECRAWL_API_KEY=

# Voyage dense embeddings + reranking.
VOYAGE_API_KEY=

# Gemini: generation, image captioning, and the RAGAS judge.
# GEMINI_API_KEY and GEMINI_API_KEY_1 are equivalent; _2 and _3 are optional
# and rotate to raise the effective per-minute quota.
GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Models. These are the defaults from src/config.py; override as needed.
# If VOYAGE_EMBED_MODEL changes dimension, update voyage_embed_dim in
# src/config.py AND the halfvec(...) columns in src/database/schema.sql.
VOYAGE_EMBED_MODEL=voyage-3-large
VOYAGE_RERANK_MODEL=rerank-2.5
GEMINI_MODEL=gemini-2.5-flash
SPLADE_MODEL=naver/splade-cocondenser-ensembledistil
