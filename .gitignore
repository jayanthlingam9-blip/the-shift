# --- Source corpus ------------------------------------------------------
# The 12 domain documents are third-party publications (and one 100 MB CSV
# that exceeds GitHub's per-file limit). See "The corpus" in README.md for
# where to obtain each one. Only the .gitkeep placeholders are tracked.
data/input/**
!data/input/*/
!data/input/**/.gitkeep

# --- Generated pipeline outputs ----------------------------------------
data/parsed/
data/normalized/
data/chunks/
data/images/
data/eval/results.json
data/image_caption_cache.json

# --- Database dumps -----------------------------------------------------
backups/
*.sqlite
*.db
*.dump

# graphify AST cache (regenerated by `graphify update .`)
graphify-out/cache/
